# Port (Render/Railway/Fly mengisi sendiri, untuk lokal default 3000)
PORT=3000

# Scraper anime aktif
SAMEHADAKU_BASE=https://v2.samehadaku.how
OTAKUDESU_BASE=https://otakudesu.blog

# Login Google (opsional) — https://console.cloud.google.com/apis/credentials
# Kosongkan kalau belum punya: aplikasi tetap jalan (tamu + tombol mode demo)
GOOGLE_CLIENT_ID=

# Database MongoDB (opsional) — atlas.com gratis 512 MB
# Kosongkan kalau tidak punya: data disimpan di memori + data/store.json
MONGODB_URI=
MONGODB_DB=kelasnime

# 0 = sembunyikan tombol "mode demo" (otomatis nonaktif kalau GOOGLE_CLIENT_ID diisi)
DEMO_LOGIN=1
